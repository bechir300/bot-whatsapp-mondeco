# ============================================================
# MONDECO — variables d'environnement
# Copier en .env pour le développement local. En production, les
# définir dans Railway (Service → Variables). Ne jamais committer .env.
# ============================================================

# --- Serveur -------------------------------------------------
PORT=3000
# Dossier des données persistantes (Railway : point de montage du volume).
DATA_DIR=/data
# URL publique de l'application (utilisée pour l'URL du webhook WooCommerce).
PUBLIC_BASE_URL=https://votre-app.up.railway.app

# --- Back-office (OBLIGATOIRE) ------------------------------
# Compte administrateur initial. Mot de passe de 12 caractères minimum.
ADMIN_EMAIL=admin@mondeco.tn
ADMIN_PASSWORD=
# Durée maximale d'une session (jours) et expiration après inactivité (heures).
MONDECO_SESSION_DAYS=14
MONDECO_SESSION_IDLE_HOURS=12

# --- Meta : webhooks (OBLIGATOIRE) --------------------------
# Jeton de vérification saisi dans la console Meta lors de l'abonnement.
VERIFY_TOKEN=
# Secret de l'application Meta : sans lui, les webhooks sont refusés.
META_APP_SECRET=
# Secrets par canal, seulement si les canaux utilisent des apps Meta différentes.
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
# Secours temporaire uniquement : accepte les webhooks non signés (déconseillé).
ALLOW_UNSIGNED_WEBHOOKS=false
META_API_VERSION=v26.0

# --- WhatsApp Cloud API -------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# --- Instagram ----------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Facebook -----------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_MESSENGER_TOKEN=
FACEBOOK_COMMENTS_TOKEN=
# Ancienne variable, utilisée en secours pour les deux jetons ci-dessus.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_REALTIME_POLL_MS=
FACEBOOK_REALTIME_LOOKBACK_MINUTES=
FACEBOOK_REALTIME_OVERLAP_MINUTES=
FACEBOOK_REALTIME_MAX_CONVERSATION_PAGES=

# --- IA -----------------------------------------------------
# Gemini est le fournisseur principal, Groq le secours.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
# Bloque l'envoi d'une réponse IA citant un prix absent du catalogue (true/false).
AI_PRICE_GUARD=true

# --- Cloudflare (génération d'images) -----------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_IMAGE_WIDTH=
CLOUDFLARE_IMAGE_HEIGHT=

# --- Cloudinary (stockage des médias) -----------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MONDECO_FOLDER=
CLOUDINARY_MIGRATION_BATCH_FILES=
CLOUDINARY_MIGRATION_MINUTES=

# --- WooCommerce (catalogue du site) ------------------------
WOOCOMMERCE_URL=https://mondeco.tn
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_SYNC_ENABLED=
WOOCOMMERCE_SYNC_IMAGES=
WOOCOMMERCE_SYNC_MINUTES=

# --- Réglages fins (optionnels, valeurs par défaut dans le code) ---
HISTORY_IMPORT_DAYS=
ACTIVE_INBOX_HOURS=
CONVERSATION_REPLY_LOCK_MINUTES=
MONDECO_STORAGE_MODE=
MONDECO_STORAGE_GUARD_MINUTES=
MONDECO_STORAGE_CRITICAL_FREE_MB=
MONDECO_STORAGE_RESCUE_FREE_MB=
MONDECO_FULL_SNAPSHOTS=
MONDECO_JSON_BACKUPS=
MONDECO_VERSIONED_BACKUP_MAX_BYTES=
MONDECO_EMERGENCY_MEDIA_DAYS=
MONDECO_MAX_NOTIFICATIONS=
MONDECO_MAX_MESSAGE_IDS=
PERSISTENCE_STRICT=true
