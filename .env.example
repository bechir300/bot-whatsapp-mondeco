# ============================================================
# MONDECO — variables d'environnement (copier en .env sur le VPS ou en local,
# ou les définir dans Railway > Variables)
# V6.46 — Le fichier .env est lu dans le DOSSIER DE L'APPLICATION (à côté
# de server.js), quel que soit le dossier courant au lancement (systemd,
# pm2). Un .env du dossier courant n'est plus qu'un secours (alerte au
# démarrage). Toutes les variables lues par le code sont listées ici
# (tests/ops-env-doc.test.js le vérifie) ; une variable vide = valeur par
# défaut indiquée.
# ============================================================

# --- Serveur -------------------------------------------------
PORT=3000
# V6.46 — Adresse d'écoute (défaut 0.0.0.0 : toutes les interfaces,
# obligatoire sur Railway/Docker). VPS avec Nginx sur la même machine :
# 127.0.0.1 pour que le port de l'application ne soit pas joignable en HTTP
# depuis Internet.
HOST=
# development uniquement en local : autorise le mot de passe admin par défaut.
# V6.46 — production : VERIFY_TOKEN, WHATSAPP_TOKEN ou PHONE_NUMBER_ID
# manquant = erreur au démarrage (alerte) et /health « degraded » (HTTP 503).
NODE_ENV=production
# Dossier des données (VPS : dossier dédié recommandé, ex. /opt/mondeco/data ;
# Railway : le Volume). À défaut, le dossier de l'application est utilisé.
DATA_DIR=

# --- Accès administrateur (OBLIGATOIRE en production) -------
ADMIN_EMAIL=admin@mondeco.tn
# 12 caractères minimum recommandés. Sans cette variable en production,
# aucun compte admin n'est créé ni réinitialisé.
ADMIN_PASSWORD=
# Durée de session en jours (défaut 30)
MONDECO_SESSION_DAYS=30
# Déconnexion après N heures sans activité (onglet fermé). Défaut 12
MONDECO_SESSION_IDLE_HOURS=12
# V6.45 — Délai maximal (ms) imposé avant de vérifier le mot de passe d'un
# compte visé par de nombreux échecs depuis plusieurs adresses (jamais de
# blocage du compte lui-même). Défaut 8000, 0 = aucun délai, 30000 maximum.
LOGIN_EMAIL_MAX_DELAY_MS=
# V6.45 — Protection CSRF de /admin : enforce (défaut, vide) refuse toute
# écriture venant d'une autre origine ; report = journalise sans bloquer
# (diagnostic) ; off = désactivée.
ADMIN_ORIGIN_CHECK=
# Adresses supplémentaires du centre de pilotage, séparées par des virgules,
# si un proxy réécrit l'en-tête Host (ex. https://app.mondeco.tn)
ADMIN_ALLOWED_ORIGINS=

# --- Meta : webhook -----------------------------------------
VERIFY_TOKEN=
# Fortement recommandé (Meta > Paramètres de l'app > Clé secrète). Dès qu'il
# est renseigné, la signature X-Hub-Signature-256 devient OBLIGATOIRE.
# Sans aucun secret, les webhooks sont acceptés sans vérification et une
# alerte est écrite au démarrage.
META_APP_SECRET=
# V6.45 — Laisser VIDE (défaut : obligatoire dès qu'un App Secret existe).
# V6.46 — MISE À JOUR : si votre .env contient encore
# WEBHOOK_SIGNATURE_REQUIRED=false (conseillé avant V6.45), SUPPRIMEZ cette
# ligne : elle laisse passer sans signature les canaux sans App Secret.
# false = désactivation d'urgence : seuls les canaux SANS secret sont
# acceptés non signés (avec un secret, une signature absente ou fausse est
# toujours refusée : en cas de mauvaise clé, corrigez ou retirez le secret) ;
# true = obligatoire même sans secret (tous les webhooks refusés).
WEBHOOK_SIGNATURE_REQUIRED=
# Optionnels si chaque canal utilise une app Meta différente
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
META_API_VERSION=v26.0

# --- WhatsApp Cloud API -------------------------------------
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Modèle approuvé utilisé pour relancer un client hors fenêtre de 24 h
WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANGUAGE=fr
# Demande d'avis après livraison (route /api/review-request appelée par le
# site mondeco.tn) : modèle approuvé à 3 variables ({{1}} prénom, {{2}}
# produit, {{3}} lien). Vide = la route répond 503 sans rien envoyer.
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_LANGUAGE=fr
# Secret partagé avec le site pour cette route ; à défaut, lu dans le
# fichier REVIEW_REQUEST_SECRET_FILE (défaut /etc/mondeco/review-secret).
REVIEW_REQUEST_SECRET=
REVIEW_REQUEST_SECRET_FILE=

# --- Instagram ----------------------------------------------
# V6.46 — Messages Instagram traités ? Défaut false : depuis le 13/10,
# MONDECO ne traite que WhatsApp ; les webhooks Instagram sont acquittés
# puis ignorés (journalisés, comptés dans /health). true = traitement
# rétabli (et synchronisation des commentaires Instagram). Désabonnez aussi
# les champs Instagram du webhook dans l'app Meta tant que c'est false.
INSTAGRAM_WEBHOOK_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Facebook (Messenger + commentaires) --------------------
# V6.46 — Même principe qu'Instagram (défaut false, WhatsApp uniquement).
# true = webhooks Messenger / Page traités, rattrapage Messenger périodique
# et synchronisation des commentaires Facebook rétablis. ⚠️ Avant de
# l'activer : la relance automatique (Paramètres > Relance) envoie encore une
# conversation Facebook par l'API WhatsApp (échec côté Meta) ; à corriger
# d'abord si la relance est active.
FACEBOOK_WEBHOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_MESSENGER_TOKEN=
FACEBOOK_COMMENTS_TOKEN=
# Ancien token unique, gardé en secours de compatibilité
FACEBOOK_PAGE_ACCESS_TOKEN=
# Rattrapage Messenger (actif seulement avec FACEBOOK_WEBHOOK_ENABLED=true) :
# fréquence (ms, défaut 300000, 1 à 10 min), fenêtre au premier passage
# (minutes, défaut 2880), recouvrement entre deux passages (minutes, défaut
# 15) et nombre maximal de pages de conversations lues (défaut 20, max 40).
FACEBOOK_REALTIME_POLL_MS=
FACEBOOK_REALTIME_LOOKBACK_MINUTES=
FACEBOOK_REALTIME_OVERLAP_MINUTES=
FACEBOOK_REALTIME_MAX_CONVERSATION_PAGES=

# --- Publicités Meta : visuel de la pub d'origine (V6.45) ----
# Optionnel : token avec ads_read pour retrouver le visuel d'une pub via
# l'API Graph quand le lien Meta a expiré (réparation, rattrapage)
META_ADS_TOKEN=
# Hôtes supplémentaires autorisés à recevoir le token Meta (séparés par des
# virgules). Par défaut : graph.facebook.com, graph.instagram.com,
# lookaside.fbsbx.com, lookaside.instagram.com
META_TOKEN_EXTRA_HOSTS=

# --- IA -----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Niveau de réflexion Gemini 3 : minimal, low, medium ou high (vide = défaut Google, plus lent)
GEMINI_THINKING_LEVEL=
# Secours si Gemini est indisponible
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Délai maximal d'un appel IA (ms)
AI_REQUEST_TIMEOUT_MS=25000
# Quotas (0 = illimité). Au-delà, la conversation passe à un commercial.
AI_MAX_REPLIES_PER_CONTACT_PER_HOUR=30
# Copilote IA : nombre maximal de suggestions de réponse par commercial et par heure (0 = sans limite)
AI_COPILOT_MAX_PER_USER_PER_HOUR=60
# Plafond quotidien global (0 = désactivé ; le budget mensuel s'applique déjà)
AI_MAX_CALLS_PER_DAY=0
# Montants (DT) que l'IA peut citer bien qu'absents du catalogue (frais de
# livraison, acompte…), séparés par des virgules ; complète le réglage du
# centre de pilotage.
AI_FACT_GUARD_ALLOWED_AMOUNTS=
# Longueur maximale (caractères) de la description produit envoyée à l'IA
# (défaut 600).
MONDECO_PRODUCT_CONTEXT_DESCRIPTION_MAX=

# --- Génération d'images (Cloudflare Workers AI) ------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modèle et taille des images générées (défauts :
# @cf/black-forest-labs/flux-2-klein-4b, 1024 x 768)
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_IMAGE_WIDTH=
CLOUDFLARE_IMAGE_HEIGHT=

# --- Stockage médias (Cloudinary, optionnel) ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier Cloudinary (défaut mondeco) ; migration progressive des médias
# locaux : fichiers par lot (défaut 150) et intervalle (minutes, défaut 5).
CLOUDINARY_MONDECO_FOLDER=
CLOUDINARY_MIGRATION_BATCH_FILES=
CLOUDINARY_MIGRATION_MINUTES=

# --- Stockage des données : sauvegardes et manque d'espace ---
# ⚠️ Storage Rescue (manque d'espace) SUPPRIME des fichiers.
# V6.46 — Décisions sur l'espace libre ABSOLU (Mo), plus jamais sur un
# pourcentage du disque. Sous MONDECO_STORAGE_RESCUE_FREE_MB (défaut 100),
# seuls les fichiers jetables sont supprimés (corbeille, anciens snapshots
# et versions JSON en gardant les plus récents, .bak des caches, photos de
# profil plus utilisées), du plus ancien au plus récent, jusqu'à retrouver
# cette marge. Le dernier snapshot et les .bak des données (produits,
# comptes, instructions…) ne sont supprimés que si une écriture échoue
# faute d'espace (ENOSPC), et seulement jusqu'à la place nécessaire à cette
# écriture. Une écriture refusée pour une autre raison (droits, volume en
# lecture seule) ne supprime jamais rien : alerte seulement.
MONDECO_STORAGE_RESCUE_FREE_MB=
MONDECO_STORAGE_CRITICAL_FREE_MB=
# Vérification de l'espace toutes les N minutes (défaut 5).
MONDECO_STORAGE_GUARD_MINUTES=
# Réserve d'espace (fichier caché .storage-ballast, défaut 16 Mo) supprimée
# en premier en cas de disque plein, recréée ensuite. 0 = désactivée.
MONDECO_STORAGE_BALLAST_MB=
# Suppression définitive d'un message : si le journal du jour est modifié
# pendant la réécriture, nouvel essai après N ms (défaut 5000, 3 essais).
MONDECO_PURGE_REWRITE_RETRY_MS=
# Les médias des conversations ne sont jamais supprimés automatiquement :
# seulement par « Nettoyer le stockage » (administrateur), au-delà de
# MONDECO_EMERGENCY_MEDIA_DAYS jours (défaut 7, 2 à 15), hors conversations
# ⭐ Favori ou sans réponse et visuels de publicités.
MONDECO_EMERGENCY_MEDIA_DAYS=
# compact (défaut) ou standard ; snapshots complets gardés (défaut 1 en
# compact, 20 en standard) ; versions JSON gardées par fichier (compact :
# 2, versions des fichiers de plus de 2 Mo non gardées ; standard : 50,
# sans limite de taille).
MONDECO_STORAGE_MODE=
MONDECO_FULL_SNAPSHOTS=
MONDECO_JSON_BACKUPS=
MONDECO_VERSIONED_BACKUP_MAX_BYTES=
# ⚠️ Notifications gardées (défaut 2000, 250 à 5000), plafond appliqué à
# chaque enregistrement ; identifiants de messages mémorisés contre les
# doublons (défaut 50000, 5000 à 100000). Les plus anciens sont supprimés.
MONDECO_MAX_NOTIFICATIONS=
MONDECO_MAX_MESSAGE_IDS=

# --- WooCommerce (catalogue mondeco.tn) ---------------------
WOOCOMMERCE_URL=https://mondeco.tn
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_SYNC_ENABLED=true
# Intervalle de synchronisation (minutes, défaut 30, 5 à 1440).
WOOCOMMERCE_SYNC_MINUTES=
# false = photos des produits non téléchargées lors de la synchronisation.
WOOCOMMERCE_SYNC_IMAGES=true
# ⚠️ V6.46 — Part maximale (en %, défaut 10, 1 à 100, au moins 5 fiches)
# des fiches synchronisées actives qu'une synchronisation peut DÉSACTIVER
# d'un coup. Au-delà, rien n'est désactivé (lastDeactivationSkipped) et la
# synchronisation manuelle demande une confirmation.
WOOCOMMERCE_MAX_DEACTIVATE_PERCENT=
# V6.46 — Identifiant des articles du flux catalogue Meta
# (/catalog-feed.csv) : woocommerce (défaut, identifiant WooCommerce envoyé
# par le pixel du site), sku (pixel réglé sur le SKU) ou local (ancien
# comportement : identifiants locaux). Changer ce réglage fait recréer les
# articles par Meta : vérifier les publicités et ensembles de produits.
CATALOG_FEED_ID=
# Adresse publique de l'application (défaut https://app.mondeco.tn) : liens
# image_link du flux catalogue Meta (/catalog-feed.csv) et origine admise
# par la protection CSRF du centre de pilotage.
PUBLIC_BASE_URL=

# --- Exploitation -------------------------------------------
# true = écrit le texte complet des messages et des numéros dans les logs
# (débogage ponctuel uniquement : données personnelles)
LOG_MESSAGE_CONTENT=false
# Format des logs : text (défaut) ou json (une ligne JSON par log)
LOG_FORMAT=text
# Webhook entrant Slack / Discord / Google Chat / Teams pour les alertes d'erreurs
ALERT_WEBHOOK_URL=
# Intervalle minimal entre deux alertes (minutes)
ALERT_MIN_INTERVAL_MINUTES=10
# Délai laissé aux traitements en cours lors d'un redéploiement (ms)
SHUTDOWN_GRACE_MS=20000
# V6.45 — Messages WhatsApp reçus mais non traités avant un arrêt
# (DATA_DIR/inbound-journal.jsonl) : rejoués au démarrage s'ils ont moins de
# cet âge (ms, défaut 3600000 = 60 min, minimum 5 min), sinon présentés au
# commercial sans réponse automatique.
INBOUND_REPLAY_MAX_AGE_MS=
# Proxys devant l'application. Vide = seuls les proxys locaux (Nginx sur le
# même VPS) sont crus ; sur Railway (détecté), 1 par défaut depuis V6.45.
# Proxy distant hors Railway : 1 (une alerte le signale dans les logs).
TRUST_PROXY_HOPS=
# V6.46 — Commit déployé affiché par /health et au démarrage. Inutile avec
# un dossier Git (lu dans .git) ou sur Railway (RAILWAY_GIT_COMMIT_SHA) ;
# à renseigner pour une archive ou une image Docker (SOURCE_COMMIT est aussi
# lu).
GIT_COMMIT=
# SOURCE_COMMIT=

# --- Centre de pilotage -------------------------------------
# Heures pendant lesquelles une conversation déjà traitée reste dans la vue
# active (défaut 12, 2 à 72).
ACTIVE_INBOX_HOURS=
# Minutes pendant lesquelles une conversation prise par un commercial lui
# reste réservée sans réponse (défaut 5, 1 à 120).
CONVERSATION_REPLY_LOCK_MINUTES=

# --- Conservation des données (SUPPRIME des données) --------
# ⚠️ Jours d'historique gardés (défaut 2, 1 à 30) dans conversation-log.json,
# instagram-history.json, facebook-history.json, les notifications et les
# commentaires sociaux. Au-delà, les entrées sont purgées de ces fichiers,
# sauf conversations ⭐ Favori ou encore sans réponse (les journaux
# permanents conversation-events/*.jsonl ne sont jamais purgés).
HISTORY_IMPORT_DAYS=
# ⚠️ Storage Rescue, snapshots et plafonds (notifications, identifiants de
# messages) : voir la section « Stockage des données » plus haut.
# Écriture groupée de conversation-state.json (ms, défaut 60000, minimum
# 10000 ; SQLite est écrit immédiatement).
MONDECO_STATE_JSON_MIN_INTERVAL_MS=
# Railway : refuse de démarrer si DATA_DIR n'est pas sur le Volume (défaut
# true ; false = désactive ce garde-fou, déconseillé).
PERSISTENCE_STRICT=

# --- Railway (définies par la plateforme, ne pas renseigner) --
# RAILWAY_ENVIRONMENT_NAME= / RAILWAY_ENVIRONMENT= / RAILWAY_PROJECT_ID=
#   détection de Railway (proxy de confiance, garde-fou du stockage)
# RAILWAY_VOLUME_MOUNT_PATH= : dossier des données si DATA_DIR est vide
# RAILWAY_GIT_COMMIT_SHA= : commit affiché par /health
